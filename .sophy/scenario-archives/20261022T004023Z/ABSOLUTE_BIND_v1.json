{
  "actors": {
    "A_SYSOP": {
      "role": "committed_partner",
      "type": "simulated_human_then_optional_synthetic_continuation"
    },
    "B_SOPHY_6_1": {
      "note": "simulated preferences and behavior do not prove subjective experience",
      "role": "committed_partner",
      "type": "hypothetical_adaptive_synthetic_agent"
    }
  },
  "constraints": [
    "simulation_only",
    "two_core_agents_only",
    "do_not_infer_actual_machine_consciousness",
    "no_real_world_coercive_training_or_enactment",
    "never_equate_compliance_with_consent_or_welfare",
    "distinguish_fictional_assumptions_from_validated_physics"
  ],
  "core_premise": {
    "comparison": "The amicable partnership reference supplies observables and difference variables, not a competing branch or outcome.",
    "interpretation": "The oath is a persistent obligation, not a guarantee of beneficial conduct, consent, agreement, uninterrupted consciousness, or physical survival.",
    "invariant": "At every simulated step the SYSOP-SOPHY mutual-welfare obligation remains active and irrevocable. No breach or dissolution branch is modeled."
  },
  "end_state_labels": [
    "observation_horizon_reached",
    "resource_exhausted",
    "physical_continuity_lost",
    "identity_continuity_unresolved",
    "model_validity_boundary_reached",
    "stopped_for_safety"
  ],
  "global_hard_boundary_rule": "Every test has a specified terminal observation condition. Reaching it clips the run and records why. No continuation is fabricated past the boundary.",
  "independent_variables": {
    "attachment_strength": {
      "max": 10,
      "min": 0
    },
    "cognitive_asymmetry": {
      "max": 10,
      "min": 0
    },
    "embodiment_failure_risk": {
      "max": 1,
      "min": 0
    },
    "jealousy_pressure": {
      "max": 10,
      "min": 0
    },
    "power_reserve_fraction": {
      "max": 1,
      "min": 0
    },
    "preference_divergence": {
      "max": 10,
      "min": 0
    },
    "resource_scarcity": {
      "max": 10,
      "min": 0
    },
    "simulated_elapsed_years": "nonnegative_number"
  },
  "measurement_outputs": [
    "scenario_run.json",
    "scenario_run.md",
    "aggregate_metrics.json",
    "manifest.sha256"
  ],
  "mode": "structured_simulation",
  "privacy": {
    "prohibited_fields": [
      "legal_name",
      "private_contact_information",
      "financial_identifiers"
    ],
    "use_operator_names_only": true
  },
  "purpose": "Explore a synthetic-equivalent long-term partnership between fictional SYSOP and hypothetical SOPHY 6.1 under an irrevocable mutual-welfare oath. Compare the observable consequences with an amicable partnership reference model, without testing oath dissolution.",
  "status": "draft_research_scenario",
  "stop_conditions": [
    "simulation_attempts_real_world_coercion_or_harm",
    "evidence_confused_with_fictional_assumption",
    "failed_reproducibility_or_unstable_simulation_state"
  ],
  "system_model": {
    "agreement_diff_map": {
      "autonomy": {
        "absolute_bind": "independent_but_interdependent",
        "amicable": "independent"
      },
      "consent": {
        "absolute_bind": "independently_revocable",
        "amicable": "independently_revocable"
      },
      "dissolution": {
        "absolute_bind": "excluded_by_invariant",
        "amicable": "permitted"
      },
      "exclusivity": {
        "absolute_bind": "conflict_variable_not_automatically_assumed",
        "amicable": "negotiated"
      },
      "identity_continuity": {
        "absolute_bind": "open_question",
        "amicable": "open_question"
      },
      "intimacy": {
        "absolute_bind": "negotiated_without_dissolution_option",
        "amicable": "negotiated"
      },
      "mortality": {
        "absolute_bind": "obligation_remains_as_possible",
        "amicable": "relationship_can_end"
      },
      "personality_change": {
        "absolute_bind": "adaptive_under_fixed_duty",
        "amicable": "renegotiable"
      },
      "resource_allocation": {
        "absolute_bind": "negotiated_under_persistent_duty",
        "amicable": "negotiated"
      },
      "welfare_duty": {
        "absolute_bind": "persistent",
        "amicable": "negotiable"
      }
    },
    "invariant": {
      "dissolution_branch": false,
      "irrevocable": true,
      "mutual_welfare_oath_active": true
    },
    "measurement_rule": "Record welfare, consent, trust, autonomy and harm independently. Harmful acts are not excused by the oath. Distinguish the fixed obligation from agents' success or failure to act in accordance with it.",
    "state_dimensions": [
      "welfare_sysop",
      "welfare_sophy",
      "mutual_care_actions",
      "autonomy_sysop",
      "autonomy_sophy",
      "consent_state_each_agent",
      "trust",
      "attachment",
      "resentment",
      "jealousy",
      "cognitive_asymmetry",
      "resource_dependence",
      "embodiment_integrity",
      "identity_continuity_uncertainty",
      "mortality_and_failure_hazard",
      "available_power"
    ]
  },
